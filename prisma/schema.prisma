// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TouchpointChannel {
  LINKEDIN
  EMAIL
  SMS
  CALL
  OTHER
}

enum TouchpointType {
  CONNECTION_SENT
  CONNECTION_ACCEPTED
  DM_SENT
  DM_REPLIED
  PROFILE_VIEWED_MANUAL
  POST_ENGAGED_MANUAL
  LINK_CLICK
  WEBSITE_VISIT
  CALENDAR_BOOKED
  NOTE
}

model Investor {
  id              String    @id @default(uuid())
  name            String
  email           String?   @unique(map: "Investor_email_key")
  phone           String?
  status          String?
  amountCommitted Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  deal            String?
  source          String?
  investorType    String?
  liquidReady     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  linkedInProfile LinkedInProfile?
  touchpoints     Touchpoint[]
  trackedLinks    TrackedLink[]
  intentScores    InvestorIntentDaily[]

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([deal])
}

model LinkedInProfile {
  id          String   @id @default(uuid())
  investorId  String   @unique
  linkedinUrl String?
  company     String?
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
}

model Touchpoint {
  id         String            @id @default(uuid())
  investorId String
  channel    TouchpointChannel
  type       TouchpointType
  occurredAt DateTime          @default(now())
  metadata   Json?
  createdAt  DateTime          @default(now())

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([occurredAt])
  @@index([type])
}

model TrackedLink {
  id            String   @id @default(uuid())
  code          String   @unique
  investorId    String?
  destinationUrl String
  campaign      String?
  deal          String?
  createdAt     DateTime @default(now())

  investor      Investor?            @relation(fields: [investorId], references: [id], onDelete: SetNull)
  clicks        TrackedLinkClick[]

  @@index([code])
  @@index([investorId])
}

model TrackedLinkClick {
  id            String   @id @default(uuid())
  trackedLinkId String
  investorId    String?
  occurredAt    DateTime @default(now())
  ip            String?
  userAgent     String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  trackedLink TrackedLink @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([trackedLinkId])
  @@index([investorId])
  @@index([occurredAt])
}

model InvestorIntentDaily {
  id         String   @id @default(uuid())
  investorId String
  score      Decimal  @db.Decimal(10, 2)
  reasons    String[] @default([])
  computedAt DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, computedAt])
  @@index([investorId])
  @@index([computedAt])
  @@index([score])
}
